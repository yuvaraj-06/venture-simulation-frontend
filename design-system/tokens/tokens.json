{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Share Ventures Design System tokens 3.0.0 (released 2026-08-27) — mirrors tokens.css (canonical). Source: ShareVentures_Brand_Guidelines.pdf v1.0.",
  "color": {
    "black": { "$type": "color", "$value": "#000000" },
    "white": { "$type": "color", "$value": "#ffffff" },
    "off-white": { "$type": "color", "$value": "#e8e6e4", "$description": "Warm off-white, print-leaning surfaces" },
    "home-bg": { "$type": "color", "$value": "#f1f4f5", "$description": "Default cool page background for digital" },
    "gray-light": { "$type": "color", "$value": "#c8cbcc" },
    "gray-mid": { "$type": "color", "$value": "#939799" },
    "gray-dark": { "$type": "color", "$value": "#5e6366" },
    "gray-xdark": { "$type": "color", "$value": "#2b3033" },
    "green": {
      "$type": "color",
      "$value": "#00d65d",
      "$description": "CTA green. Interactive elements only — never decoration, never the logo. PDF p.21 label '#0038C7' is a typo; p.31 digital style guide value is canonical."
    },
    "semantic": {
      "light": {
        "surface": { "$type": "color", "$value": "{color.home-bg}" },
        "surface-raised": { "$type": "color", "$value": "{color.white}" },
        "surface-sunken": { "$type": "color", "$value": "{color.off-white}" },
        "ink": { "$type": "color", "$value": "{color.black}" },
        "ink-secondary": { "$type": "color", "$value": "{color.gray-dark}" },
        "ink-tertiary": { "$type": "color", "$value": "{color.gray-mid}" },
        "hairline": { "$type": "color", "$value": "{color.gray-light}" },
        "accent": { "$type": "color", "$value": "{color.green}" },
        "accent-ink": { "$type": "color", "$value": "{color.black}" }
      },
      "dark": {
        "surface": { "$type": "color", "$value": "{color.black}" },
        "surface-raised": { "$type": "color", "$value": "{color.gray-xdark}" },
        "surface-sunken": { "$type": "color", "$value": "{color.black}" },
        "ink": { "$type": "color", "$value": "{color.white}" },
        "ink-secondary": { "$type": "color", "$value": "{color.gray-light}" },
        "ink-tertiary": { "$type": "color", "$value": "{color.gray-mid}" },
        "hairline": { "$type": "color", "$value": "{color.gray-dark}" },
        "accent": { "$type": "color", "$value": "{color.green}" },
        "accent-ink": { "$type": "color", "$value": "{color.black}" }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": ["var(--font-aeonik, \"Aeonik Pro\")", "Aeonik", "Arial", "Helvetica Neue", "Helvetica", "sans-serif"],
        "$description": "Uses a licence-managed --font-aeonik when available; Arial is the brand-sanctioned fallback."
      }
    },
    "weight": {
      "thin": { "$type": "fontWeight", "$value": 100 },
      "light": { "$type": "fontWeight", "$value": 300 },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "black": { "$type": "fontWeight", "$value": 900 }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "clamp(3rem, 8vw, 6rem)", "$description": "XL headlines — weight Regular" },
      "h1": { "$type": "dimension", "$value": "clamp(2.5rem, 5vw, 3.5rem)", "$description": "Weight Medium" },
      "h2": { "$type": "dimension", "$value": "clamp(2rem, 3.5vw, 2.5rem)", "$description": "Weight Medium" },
      "h3": { "$type": "dimension", "$value": "1.75rem", "$description": "Weight Medium" },
      "h4": { "$type": "dimension", "$value": "1.25rem", "$description": "Weight Regular" },
      "intro": { "$type": "dimension", "$value": "1.5rem" },
      "body": { "$type": "dimension", "$value": "1.125rem" },
      "small": { "$type": "dimension", "$value": "0.9375rem" },
      "caption": { "$type": "dimension", "$value": "0.8125rem" },
      "stat": { "$type": "dimension", "$value": "clamp(4rem, 10vw, 8rem)", "$description": "Stat numerals — weight Regular" }
    },
    "leading": {
      "display": { "$type": "number", "$value": 1.02 },
      "heading": { "$type": "number", "$value": 1.1 },
      "intro": { "$type": "number", "$value": 1.35 },
      "body": { "$type": "number", "$value": 1.6 }
    },
    "tracking": {
      "display": { "$type": "dimension", "$value": "-0.02em" },
      "heading": { "$type": "dimension", "$value": "-0.01em" },
      "body": { "$type": "dimension", "$value": "0" },
      "caps": { "$type": "dimension", "$value": "0.04em" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" },
    "48": { "$type": "dimension", "$value": "192px" }
  },
  "layout": {
    "container": { "$type": "dimension", "$value": "1440px" },
    "rail": { "$type": "dimension", "$value": "288px", "$description": "Editorial left-rail column" },
    "radius": { "$type": "dimension", "$value": "0px", "$description": "Sharp corners everywhere. Always 0." },
    "hairline": { "$type": "dimension", "$value": "1px" }
  },
  "motion": {
    "ease": {
      "out": { "$type": "cubicBezier", "$value": [0.16, 1, 0.3, 1], "$description": "Signature exponential ease-out" },
      "inout": { "$type": "cubicBezier", "$value": [0.76, 0, 0.24, 1] },
      "linear": { "$type": "cubicBezier", "$value": [0, 0, 1, 1] }
    },
    "duration": {
      "instant": { "$type": "duration", "$value": "100ms" },
      "fast": { "$type": "duration", "$value": "200ms" },
      "base": { "$type": "duration", "$value": "300ms" },
      "slow": { "$type": "duration", "$value": "600ms" },
      "cine": { "$type": "duration", "$value": "1000ms" }
    },
    "stagger": { "$type": "duration", "$value": "80ms" },
    "reveal-distance": { "$type": "dimension", "$value": "24px" }
  }
}
